# Copy to .env (git-ignored) for Docker Compose. `companyos up` reads the process environment and
# backend/.env instead; every variable is documented in docs/deploy.md.

# --- ports and URLs ---------------------------------------------------------------------------
COMPANYOS_PORT=8700
# 127.0.0.1 = this machine only. 0.0.0.0 publishes on your network: set a strong owner password first.
COMPANYOS_BIND=127.0.0.1
# The address people type; used in printed links.
COMPANY_OS_PUBLIC_URL=http://localhost:8700
# Set to 1 when a TLS-terminating proxy or tunnel fronts the app and requests arrive as plain http.
COMPANY_OS_COOKIE_SECURE=

# --- secrets ---------------------------------------------------------------------------------------
# Encrypts stored credentials and signs agent run tokens. Empty = a key is generated into the data
# volume (data/secret.key) on first start. Set it (e.g. `openssl rand -hex 32`) if you want it outside the volume.
COMPANY_OS_SECRET_KEY=

# --- database ----------------------------------------------------------------------------------
# Default: SQLite inside the `data` volume. For PostgreSQL (UNVERIFIED, see docs/deploy.md):
#   WITH_POSTGRES=1
#   POSTGRES_PASSWORD=change-me
#   COMPANY_OS_DATABASE_URL=postgresql+psycopg://companyos:change-me@postgres:5432/companyos
#   docker compose --profile postgres up -d --build
COMPANY_OS_DATABASE_URL=sqlite:////data/company_os.db
WITH_POSTGRES=0
POSTGRES_PASSWORD=

# --- build options -------------------------------------------------------------------------------
# 0 = leave the agent runtime (Hermes fork, ~180 MB venv) out of the image.
WITH_RUNTIME=1
