# Copy to .env (gitignored). All values here are placeholders, not real secrets.

# SQLite path is resolved relative to backend/. Use a postgresql+psycopg:// URL in production.
COMPANY_OS_DATABASE_URL=sqlite:///../data/company_os.db

# "password" (default) = username + password accounts (first-run setup in the web app).
# "local" = DEV ONLY single owner authenticated by data/owner.token; refuses non-loopback binds
# and clients (see README "Accounts and logging in").
COMPANY_OS_AUTH_MODE=password
# The interface the server is bound to (the launcher sets it; `local` mode requires loopback).
# COMPANY_OS_BIND_HOST=127.0.0.1

# JSON list of origins allowed by CORS (the Vite dev server by default).
COMPANY_OS_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Hermes Agent gateway (optional). Leave unset and the runtime shows "not_configured".
# HERMES_API_URL=http://127.0.0.1:8642
# HERMES_API_KEY=<the gateway's API_SERVER_KEY>

# --- Work engine (Milestone 2) ---------------------------------------------------------
# Run the worker + scheduler inside the API process (otherwise: `uv run companyos-worker`).
# COMPANY_OS_EMBEDDED_WORKER=1
# Registers the deterministic "scripted" test runtime. Never enable in production.
# COMPANY_OS_ENABLE_TEST_RUNTIMES=1
# HMAC key for agent run tokens. Unset = generated once into <data dir>/secret.key (mode 0600).
# COMPANY_OS_SECRET_KEY=<long random string>
# COMPANY_OS_MAX_UPLOAD_BYTES=26214400

# --- Milestone 3b: company agent runtime, providers, login -----------------------------
# Where you open the app: used for the login link printed at startup.
# COMPANY_OS_PUBLIC_URL=http://localhost:8700
# 1/0 forces/suppresses printing the login link (default: print only when stderr is a terminal).
# COMPANY_OS_PRINT_LOGIN_URL=1
# Runtime virtualenv interpreter (default <repo>/runtime/.venv/bin/python) and checkout.
# COMPANY_OS_RUNTIME_PYTHON=/abs/path/to/runtime/.venv/bin/python
# COMPANY_OS_RUNTIME_DIR=/abs/path/to/runtime
# Where runtimes reach the agent API (must match the port you serve on).
# COMPANY_OS_AGENT_API_URL=http://127.0.0.1:8700/api/agent/v1
# SIGTERM -> SIGKILL grace when cancelling a run, and the docker image for sandboxed tools.
# COMPANY_OS_RUNTIME_KILL_GRACE_SECONDS=10
# COMPANY_OS_SANDBOX_DOCKER_IMAGE=python:3.12-slim
# Model API keys are NOT environment variables: store them with POST /api/companies/{id}/credentials.
