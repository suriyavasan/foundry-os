{
  "version": 1,
  "_comment": "Runtime tool registry (docs/specs/m6 section 1): the single source of truth for which tools exist and their risk tier. The control plane puts it into every run spec; the runtime refuses any tool that is not listed (fail closed) and checks the non-read tiers with the control plane before the tool runs. runtime/company_agent/tests/test_guard_registry.py compares it with the tools Hermes actually resolves.",
  "toolsets": {
    "file": ["read_file", "write_file", "patch", "search_files"],
    "web": ["web_search"],
    "search": ["web_search"],
    "skills": ["skills_list", "skill_view"],
    "todo": ["todo_list"],
    "vision": ["vision_analyze"],
    "terminal": ["terminal", "process_manage"],
    "code_execution": ["execute_code"]
  },
  "always": ["tool_search", "tool_describe", "tool_call"],
  "never_granted": ["skill_manage", "web_extract"],
  "tools": {
    "read_file": {"tier": "read", "untrusted": "file"},
    "search_files": {"tier": "read", "untrusted": "file"},
    "write_file": {"tier": "internal_write"},
    "patch": {"tier": "internal_write"},
    "web_search": {"tier": "external_read", "untrusted": "web"},
    "web_extract": {"tier": "external_read", "untrusted": "web"},
    "skills_list": {"tier": "read"},
    "skill_view": {"tier": "read"},
    "skill_manage": {"tier": "org_change"},
    "todo_list": {"tier": "internal_write"},
    "vision_analyze": {"tier": "external_read", "untrusted": "file"},
    "terminal": {"tier": "internal_write", "untrusted": "command_output"},
    "process_manage": {"tier": "internal_write"},
    "execute_code": {"tier": "internal_write", "untrusted": "command_output"},
    "tool_search": {"tier": "read"},
    "tool_describe": {"tier": "read"},
    "tool_call": {"tier": "read"}
  },
  "company_tools": {
    "company_get_context": {"action": "context.read"},
    "company_get_state": {"action": "state.read"},
    "company_create_task": {"action": "task.create"},
    "company_plan_project": {"action": "task.create"},
    "company_update_task": {"action": "task.update"},
    "company_complete_task": {"action": "task.complete"},
    "company_review_task": {"action": "task.review"},
    "company_submit_artifact": {"action": "artifact.submit"},
    "company_report_progress": {"action": "progress.report"},
    "company_record_decision": {"action": "decision.record"},
    "company_request_approval": {"action": "approval.request"},
    "company_decide_approval": {"action": "approval.decide"},
    "company_decide_peer_review": {"action": "peer_review.decide"},
    "company_provider_action": {"action": "provider.action", "untrusted": "provider"},
    "company_find_colleagues": {"action": "colleagues.search"},
    "company_request_hire": {"action": "hire.request"},
    "company_search_skills": {"action": "skills.catalog"},
    "company_install_skill": {"action": "skills.install"},
    "company_author_skill": {"action": "skills.author"},
    "company_assign_skills": {"action": "skills.assign"},
    "company_list_role_templates": {"action": "role_templates.read"},
    "company_create_role_template": {"action": "role_templates.create"},
    "company_hire_agent": {"action": "hire.create"},
    "company_list_notes": {"action": "notes.read"},
    "company_triage_note": {"action": "note.triage"},
    "company_reply_to_note": {"action": "note.reply"},
    "company_manage_goal": {"action": "goal.create"},
    "company_manage_project": {"action": "project.create"},
    "company_manage_schedule": {"action": "schedule.create"},
    "company_escalate": {"action": "escalation.create"},
    "company_request_help": {"action": "help.request"},
    "company_propose_memory": {"action": "memory.propose"},
    "company_verify_memory": {"action": "memory.verify"},
    "company_post_reflection": {"action": "reflection.post"},
    "company_reply_reflection": {"action": "reflection.reply"},
    "company_revise_reflection": {"action": "reflection.revise"},
    "company_request_purchase": {"action": "purchase.request"},
    "company_review_subscription": {"action": "subscription.review"}
  }
}
