<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS LaunchAgent for Foundry AI OS: ~/Library/LaunchAgents/ai.foundry-os.plist
  Placeholders (filled in by `foundryos service install`):
    @FOUNDRYOS_BIN@  absolute path of the foundryos launcher (the stable link, so updates apply on restart)
    @PATH@           PATH for the service (launchd's default is minimal)
    @LOG_DIR@        <data dir>/logs
  Homebrew installs use the formula's `service do` block (brew services) instead of this file.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.foundry-os</string>
    <key>ProgramArguments</key>
    <array>
        <string>@FOUNDRYOS_BIN@</string>
        <string>serve</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>@PATH@</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>@LOG_DIR@/foundry-os.log</string>
    <key>StandardErrorPath</key>
    <string>@LOG_DIR@/foundry-os.log</string>
</dict>
</plist>
