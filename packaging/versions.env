# Pinned inputs of the release bundles (sourced by scripts/build_bundle.sh and the workflows).
# Plain KEY=value lines only: this file is read by POSIX sh and by GitHub Actions (>> $GITHUB_ENV).
#
# python-build-standalone (https://github.com/astral-sh/python-build-standalone): the relocatable
# CPython that each bundle ships (one for the backend, one for the agent runtime). The runtime keeps
# Hermes' exact pins, which cover Python 3.14 only. To bump: pick a release tag, copy the matching
# lines from that release's SHA256SUMS (file names below), update both PBS_* lines.
PBS_TAG=20261021
PBS_PYTHON_VERSION=3.14.9

# SHA-256 of cpython-<PBS_PYTHON_VERSION>+<PBS_TAG>-<triple>-install_only_stripped.tar.gz
PBS_SHA256_aarch64_apple_darwin=9f8c3480b8f0db553c270db548e8a21ae8e39df412e5661d66e8050c5c6ed2a8
PBS_SHA256_x86_64_apple_darwin=9957784870f6eb613ab82fa7ac3201627940f493e6643c749fb3f126930a4232
PBS_SHA256_aarch64_unknown_linux_gnu=6f77731d85a14ed848dd4041478cd3ed511523caa3d896b84b436a7edf13cf62
PBS_SHA256_x86_64_unknown_linux_gnu=561e91c1cadf30e84aec94d1917384ae3267e5f3e6e135e51fd1578bb19f4064

# uv builds the bundles (dependency install from the frozen lockfiles). Not shipped.
UV_VERSION=0.13.5

# Agent-runtime extras, same as runtime/README.md and the Docker image (keyless web search + native
# Anthropic provider). No browser, media or messaging extras.
RUNTIME_EXTRAS="anthropic ddgs"
